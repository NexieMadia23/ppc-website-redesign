DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Absolute origin, no trailing slash. Used by robots.txt. In production set
# this to the real https:// domain.
DJANGO_SITE_URL=http://localhost:8020
# Optional. Leave blank to hide from the header. Use the real, verified numbers.
SITE_PHONE=(048) 717-8000
SITE_EMAIL=info@puertoprincesa.ph

# Railway injects DATABASE_URL, RAILWAY_PUBLIC_DOMAIN, and
# RAILWAY_VOLUME_MOUNT_PATH at runtime; do not set them locally.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-custom-domain.example
